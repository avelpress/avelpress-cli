# Credentials used by `avel release` and `avel release:doctor`.
#
# Copy this file to .env in the project, or to ~/.avelpress/.env to share a
# single set of credentials across every plugin on the machine. Real environment
# variables win over the project file, which wins over the global one.

AVELPRESS_SITE_URL=https://example.com

# WordPress application password (Users > Profile > Application Passwords).
# Authenticates both the media upload and the WooCommerce routes.
AVELPRESS_WP_USER=
AVELPRESS_WP_APP_PASSWORD=

# Optional: WooCommerce REST key, used instead of the application password for
# the store routes (WooCommerce > Settings > Advanced > REST API).
AVELPRESS_WC_KEY=
AVELPRESS_WC_SECRET=

# Optional: endpoint that receives the update manifest after a release, so the
# self-update of installed plugins never lags behind the store.
AVELPRESS_RELEASE_WEBHOOK=
AVELPRESS_RELEASE_TOKEN=
